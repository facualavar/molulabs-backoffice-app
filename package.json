{
    "name": "www",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "static-gen": "panda codegen",
        "start": "pnpm static-gen && vite --host",
        "build": "pnpm static-gen && tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest run",
        "prepare-husky": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,md}": [
            "eslint --cache --fix --no-warn-ignored",
            "prettier --write ./src"
        ]
    },
    "dependencies": {
        "@molulabs/ds": "github:facualavar/molulabs-desing-system#v0.1.0",
        "@reduxjs/toolkit": "^2.12.0",
        "@tanstack/react-query": "^5.101.4",
        "axios": "^1.18.1",
        "formik": "^2.4.9",
        "lucide-react": "^1.27.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-redux": "^9.3.0",
        "react-router": "^8.3.0",
        "sonner": "^2.0.7",
        "yup": "^1.7.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@eslint/js": "^10.0.1",
        "@pandacss/dev": "^1.11.5",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^24.13.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "eslint": "^10.6.0",
        "eslint-plugin-perfectionist": "^5.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.2.0",
        "postcss": "^8.5.22",
        "prettier": "^3.9.6",
        "prettier-plugin-sort-json": "^4.2.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.62.0",
        "vite": "^8.1.1",
        "vitest": "^4.1.10"
    }
}
