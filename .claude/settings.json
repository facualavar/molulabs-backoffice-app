{
    "hooks": {
        "PreToolUse": [
            {
                "hooks": [
                    {
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-env-files.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "Bash"
            }
        ]
    },
    "permissions": {
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.*.local)",
            "Read(**/.env.development)",
            "Read(**/.env.production)",
            "Read(**/.env.test)",
            "Edit(**/.env)",
            "Edit(**/.env.local)",
            "Edit(**/.env.*.local)",
            "Edit(**/.env.development)",
            "Edit(**/.env.production)",
            "Edit(**/.env.test)"
        ]
    }
}
